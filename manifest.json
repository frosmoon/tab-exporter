{
    "manifest_version": 3,
    "name": "Tab exporter",
    "version": "1.0",
    "description": "Export tabs to a file.",
    "background": {
        "service_worker": "background.js"
    },
    "permissions": [
        "tabs",
        "activeTab"
    ],
    "host_permissions": [
        "<all_urls>"
    ],
    "action": {
        "default_popup": "index.html",
        "default_icon": {
            "16": "icon16.jpeg",
            "32": "icon32.jpeg",
            "48": "icon48.jpeg",
            "128": "icon128.jpeg"
        }
    },
    "web_accessible_resources": [{
        "resources": ["script.js"],
        "matches": ["<all_urls>"]
    }]
}